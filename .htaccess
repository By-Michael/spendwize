# ── Block direct access to sensitive files ───────────────────────────────────

# Config files — must never be downloadable
<FilesMatch "^(config\.php|config\.production\.php|config\.example\.php|db\.local\.php|mailer\.local\.php)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# PHP files that are not entry points
<FilesMatch "^(functions\.php|database\.sql|README\.md|composer\.json)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Block the entire scripts/ directory from web access
# (send-notifications.php is a CLI script, not a web endpoint)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^scripts/ - [F,L]
    RewriteRule ^PHPMailer/ - [F,L]
    RewriteRule ^i18n/.*\.php$ - [F,L]
</IfModule>

# ── Disable directory listings ────────────────────────────────────────────────
Options -Indexes

# ── Security headers ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Block access to dotfiles (.git, .env, etc.) ───────────────────────────────
<FilesMatch "^\.">
    Order Allow,Deny
    Deny from all
</FilesMatch>
